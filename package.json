{
  "name": "git-workflow",
  "displayName": "Git Workflow",
  "description": "Discover git worktrees and compare each Working Tree against its base ref — GitLens-style, editable diffs.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "diff",
    "compare",
    "workflow",
    "claude"
  ],
  "activationEvents": [
    "onView:worktreeCompare.worktrees"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Workflow",
      "properties": {
        "worktreeCompare.watchFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".claude/worktrees"
          ],
          "description": "Workspace-relative folders to scan for git worktrees. Each direct child directory that is a git worktree is listed."
        },
        "worktreeCompare.defaultBaseRef": {
          "type": "string",
          "default": "main",
          "description": "Fallback base ref when a worktree's fork point cannot be inferred (reflog / merge-base / upstream)."
        },
        "worktreeCompare.includeRootCheckout": {
          "type": "string",
          "enum": ["dirty", "always", "never"],
          "default": "dirty",
          "enumDescriptions": [
            "Only list the root checkout when it has uncommitted changes (hide when empty/clean)",
            "Always list the workspace root git checkout first",
            "Never list the root checkout (linked worktrees only)"
          ],
          "description": "Whether to include the main workspace checkout in the Worktrees list. Default: hide when clean (empty working tree)."
        },
        "worktreeCompare.squashLayout": {
          "type": "string",
          "enum": ["list", "tree"],
          "default": "list",
          "description": "How to show files under Full Diff: flat list or nested directory tree."
        },
        "worktreeCompare.contentRefreshIntervalMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Hot-follow idle poll interval for the focused worktree (ms). 0 = off (default; events only). When >0, uses decaying active/idle poll. Prefer events; enable poll only if agents write outside the editor."
        },
        "worktreeCompare.contentRefreshActiveIntervalMs": {
          "type": "number",
          "default": 2500,
          "minimum": 1000,
          "description": "Hot-follow active poll interval (ms) after a change is detected. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.contentRefreshIdleAfterMs": {
          "type": "number",
          "default": 20000,
          "minimum": 3000,
          "description": "Quiet time before poll pace returns to idle. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.githubPullRequests": {
          "type": "string",
          "enum": ["auto", "off"],
          "default": "auto",
          "enumDescriptions": [
            "Use the GitHub CLI (gh) when available to detect PRs for worktree branches",
            "Disable GitHub PR status and context actions"
          ],
          "description": "Optional GitHub integration: show PR status on worktree rows, Remote PRs section, and Open/Copy PR actions. Requires authenticated `gh` on PATH."
        },
        "worktreeCompare.remotePrLimit": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Max open pull requests to list under Remote PRs."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeCompare",
          "title": "Git Workflow",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktreeCompare": [
        {
          "id": "worktreeCompare.worktrees",
          "name": "Worktree"
        }
      ]
    },
    "commands": [
      {
        "command": "worktreeCompare.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.selectWorktree",
        "title": "Select Worktree…",
        "icon": "$(list-selection)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.focusWorktree",
        "title": "Focus Worktree",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openWorktree",
        "title": "Reveal Worktree in Explorer",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.deleteWorktree",
        "title": "Delete Worktree…",
        "icon": "$(trash)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.unlockWorktree",
        "title": "Unlock Worktree",
        "icon": "$(unlock)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openFileDiff",
        "title": "Open File Diff",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.changeBaseRef",
        "title": "Change Base Ref",
        "icon": "$(git-compare)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.stageFile",
        "title": "Stage",
        "icon": "$(add)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.unstageFile",
        "title": "Unstage",
        "icon": "$(remove)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.copyCommitSha",
        "title": "Copy Commit SHA",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openLogFile",
        "title": "Open Durable Log File",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.toggleSquashLayout",
        "title": "Toggle Full Diff List/Tree Layout",
        "icon": "$(list-tree)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openPullRequest",
        "title": "Open Pull Request on GitHub",
        "icon": "$(github)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.copyPullRequestUrl",
        "title": "Copy Pull Request URL",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.refreshPullRequests",
        "title": "Refresh Pull Request Status",
        "icon": "$(git-pull-request)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.refreshRemotePrs",
        "title": "Refresh Remote PRs",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openRemotePrFile",
        "title": "Open Read-only PR Diff",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.createWorktreeFromPr",
        "title": "Create Worktree from PR…",
        "icon": "$(repo-clone)",
        "category": "Git Workflow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeCompare.selectWorktree",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "worktreeCompare.refreshPullRequests",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "worktreeCompare.refresh",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.worktrees && viewItem == conflictWarning",
          "group": "0_github@1"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.worktrees && viewItem == conflictWarning",
          "group": "0_compare@2"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.worktrees && viewItem == section:squash",
          "group": "inline"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /WithPr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /WithPr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.openWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /^worktreeListItem/",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.unlockWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Locked/",
          "group": "1_worktree@1"
        },
        {
          "command": "worktreeCompare.deleteWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Removable/",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /^remotePr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /^remotePr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.createWorktreeFromPr",
          "when": "view == worktreeCompare.worktrees && viewItem == remotePr",
          "group": "2_worktree@1"
        },
        {
          "command": "worktreeCompare.refreshRemotePrs",
          "when": "view == worktreeCompare.worktrees && viewItem == group:remotePrs",
          "group": "inline"
        },
        {
          "command": "worktreeCompare.copyCommitSha",
          "when": "view == worktreeCompare.worktrees && viewItem == commit",
          "group": "1_copy"
        },
        {
          "command": "worktreeCompare.stageFile",
          "when": "view == worktreeCompare.worktrees && viewItem == unstagedFile",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.stageFile",
          "when": "view == worktreeCompare.worktrees && viewItem == unstagedFile",
          "group": "1_scm"
        },
        {
          "command": "worktreeCompare.unstageFile",
          "when": "view == worktreeCompare.worktrees && viewItem == stagedFile",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.unstageFile",
          "when": "view == worktreeCompare.worktrees && viewItem == stagedFile",
          "group": "1_scm"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vsix": "npm run package && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license",
    "install:local": "node scripts/install-local.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
