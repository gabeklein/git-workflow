{
  "name": "git-workflow",
  "displayName": "Git Workflow",
  "description": "Discover git worktrees and compare each Working Tree against its base ref \u2014 GitLens-style, editable diffs.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabeklein/git-workflow.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "diff",
    "compare",
    "workflow",
    "claude"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Workflow",
      "properties": {
        "worktreeCompare.watchFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".worktrees"
          ],
          "description": "Workspace-relative folders where new worktrees (e.g. PR checkouts) are created. Discovery itself uses `git worktree list`, so worktrees are found no matter where they live on disk."
        },
        "worktreeCompare.defaultBaseRef": {
          "type": "string",
          "default": "main",
          "description": "Fallback base ref when a worktree's fork point cannot be inferred (reflog / merge-base / upstream)."
        },
        "worktreeCompare.squashLayout": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "default": "list",
          "description": "How to show files under Full Diff: flat list or nested directory tree."
        },
        "worktreeCompare.contentRefreshIntervalMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Hot-follow idle poll interval for the focused worktree (ms). 0 = off (default; events only). When >0, uses decaying active/idle poll. Prefer events; enable poll only if agents write outside the editor."
        },
        "worktreeCompare.contentRefreshActiveIntervalMs": {
          "type": "number",
          "default": 2500,
          "minimum": 1000,
          "description": "Hot-follow active poll interval (ms) after a change is detected. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.contentRefreshIdleAfterMs": {
          "type": "number",
          "default": 20000,
          "minimum": 3000,
          "description": "Quiet time before poll pace returns to idle. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.githubPullRequests": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use the GitHub CLI (gh) when available to detect PRs for worktree branches",
            "Disable GitHub PR status and context actions"
          ],
          "description": "Optional GitHub integration: PR badges on worktrees and branches, and Open/Copy PR actions. Requires authenticated `gh` on PATH."
        },
        "worktreeCompare.previewBranch": {
          "type": "string",
          "default": "preview/{base}",
          "description": "Branch name of the preview overlay; {base} expands to the short base name (preview/main). Preview mode is the WORKSPACE ROOT checkout switched to this branch, where it is rebuilt as the base plus a merge of each applied lane \u2014 the same branch checked out in a linked worktree is left alone. Set to focus/working for interop with agent-focus's scripts/focus-working.sh (shared focus-applied file and lock)."
        },
        "worktreeCompare.previewBaseRef": {
          "type": "string",
          "default": "",
          "description": "Base ref preview rebuilds start from (origin/\u2026 preferred when it resolves). Empty = use defaultBaseRef. Change via the Preview row's context menu."
        },
        "worktreeCompare.previewAutoResolve": {
          "type": "string",
          "enum": [
            "off",
            "whitespace",
            "best-effort"
          ],
          "default": "best-effort",
          "enumDescriptions": [
            "Strict: any clash fails the rebuild. Non-overlapping edits to the same file still merge (git default).",
            "Also resolve whitespace-only clashes plus everything provably LOSSLESS: union when both lanes only inserted lines (changelog appends, import lists) and linewise 3-way for adjacent-line edits.",
            "Everything 'whitespace' does, and remaining text clashes resolve toward the incoming lane \u2014 the rebuild never fails on content, and any lane where a hunk was dropped is TAGGED 'auto-resolved' with the files listed. ('lane-wins' is accepted as a legacy alias.)"
          ],
          "description": "How far preview rebuilds may auto-resolve merge clashes between lanes. The preview tree is a derived, best-effort preview of unlanded work \u2014 lossless resolutions are silent, lossy ones are tagged on the lane row, and structural conflicts (edit vs delete) still fail honestly."
        },
        "worktreeCompare.catchUpStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "rebase",
            "merge"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Rebase unpushed lanes (history still private); merge the base into pushed lanes (no force-push, review anchors survive \u2014 squash landings erase the merge bubbles anyway).",
            "Always rebase; pushed lanes get a Force Push (with lease) offer afterward.",
            "Always merge the base in \u2014 never rewrites history."
          ],
          "description": "How Catch Up with Base brings a lane up to date with its base."
        },
        "worktreeCompare.autoRebaseLanes": {
          "type": "string",
          "enum": [
            "off",
            "local-only"
          ],
          "default": "off",
          "enumDescriptions": [
            "Never catch lanes up automatically \u2014 rows show 'N behind' / 'conflicts with <base>' with manual actions.",
            "Automatically catch up linked worktrees that are clean, behind the base, conflict-free, and NOT pushed (method follows catchUpStrategy). Pushed branches are never rewritten automatically \u2014 use Rebase onto Base\u2026, which offers a force-push with lease."
          ],
          "description": "Keep feature worktrees caught up with the base automatically when it is safe. A conflicting attempt aborts cleanly and marks the row 'conflicts with <base>'. Off by default: moving your branch is a side effect you opt into."
        },
        "worktreeCompare.previewFetchIntervalMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "While preview mode is on, `git fetch origin <base>` this often (ms) so the preview tree tracks where PRs actually land; a moved tip triggers an auto-rebuild and landed lanes retire. 0 = never fetch automatically (manual Rebuild still fetches first)."
        },
        "worktreeCompare.previewAbsorbStrays": {
          "type": "boolean",
          "default": true,
          "description": "When work is committed directly on the preview checkout, move it onto the base branch's worktree automatically (it then shows as unpushed base work). The preview tree is derived and gets reset on every rebuild, so those commits would otherwise deadlock the preview. Commits that ADD files while lanes are applied always ask first \u2014 an added file has no diff context, so unlike an edit it applies to the base cleanly even when its contents depend on lane code. Off = the rebuild keeps refusing until Absorb is run by hand. Uncommitted edits are never absorbed automatically."
        },
        "worktreeCompare.previewCommitGuard": {
          "type": "boolean",
          "default": true,
          "description": "Install a pre-commit hook that refuses commits made while the preview branch is checked out (which, in preview mode, is the workspace root). That branch is derived and rebuilt with reset --hard, so a commit there has no home. Use git commit --no-verify to override for a single commit. An existing pre-commit hook is chained into rather than replaced; one that is not a shell script is left alone. Honors core.hooksPath."
        },
        "worktreeCompare.quickDeleteLandedWorktrees": {
          "type": "boolean",
          "default": true,
          "description": "Delete a landed worktree without the confirmation modal. Only applies when the branch's commits are already contained in its base AND the checkout is clean, unlocked, attached, and holds no ignored files \u2014 `git worktree remove` deletes ignored files (a local .env, build output) without complaint, and the dirty probe cannot see them. Off = every delete is confirmed."
        },
        "worktreeCompare.autoRemoveLandedWorktrees": {
          "type": "boolean",
          "default": true,
          "description": "Remove the checkout of a landed branch as soon as it holds nothing of its own \u2014 clean, unlocked, no ignored files, no paused rebase/merge, nothing open in an editor. The branch REF is never deleted (that is Prune Landed Branches), so this only gives back a folder `git worktree add` recreates. Off keeps every folder and still badges the row `landed \u00b7 on disk`: seeing that the disk is reclaimable is not what this switches off."
        },
        "worktreeCompare.expendableIgnored": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "node_modules", ".yarn/cache", ".pnpm-store", "bower_components",
            "vendor/bundle", ".bundle", ".venv", "venv", "__pycache__", ".tox", "Pods",
            "dist", "build", "out", "target", ".next", ".nuxt", ".svelte-kit",
            ".astro", ".output", ".parcel-cache", ".docusaurus",
            ".cache", ".turbo", ".vite", ".eslintcache", ".stylelintcache",
            ".mypy_cache", ".ruff_cache", ".pytest_cache", ".gradle", ".terraform",
            ".sass-cache",
            "coverage", ".nyc_output", "test-results", "playwright-report",
            "blob-report", ".vscode-test", "*.tsbuildinfo", "*.log",
            "npm-debug.log*", "yarn-error.log",
            ".DS_Store", "Thumbs.db"
          ],
          "markdownDescription": "Gitignored paths that do NOT keep a landed checkout on disk. Ignored files are the one thing removing a worktree can destroy \u2014 the dirty probe cannot see them and `git worktree remove` takes them without complaint \u2014 so any ignored file normally blocks removal. In a repo that installs per worktree that means every landed lane keeps its folder forever over a `node_modules`. These entries are derived (a build, install, or test run recreates them) and so are deleted with the folder and named in Output \u2192 Git Workflow. Anything not listed still blocks: a `.env`, a local dump, scratch notes. This REPLACES the built-in list rather than extending it, so an entry can be taken back out; `[]` restores the old behavior of blocking on any ignored file. Gitignore-shaped matching: a bare name matches at any depth, a pattern with `/` is anchored at the checkout root, `*` and `?` glob within a segment.\n\n**Do not add anything whose contents exist only in that folder.**"
        },
        "worktreeCompare.pruneRemoteRefs": {
          "type": "boolean",
          "default": true,
          "description": "Prune remote-tracking refs for branches origin no longer has, on the full refresh (throttled to once a minute). Nothing else in git removes them \u2014 fetches here are targeted refspecs and `git pull` does not prune \u2014 so a branch deleted on the remote, which is what merging a PR does by default, otherwise shows under Remote forever. Pruning drops only the cache entry; the next fetch restores it if the branch is real."
        },
        "worktreeCompare.previewAutoRebuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuild the preview when the base or an applied lane tip moves (checked on the worktree-list poll). Off = rebuild only via the Rebuild Preview command or external hooks."
        },
        "worktreeCompare.remotePrLimit": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Max open pull requests fetched for the Branches panel's PR tags."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeCompare",
          "title": "Git Workflow",
          "icon": "media/worktree.svg"
        }
      ]
    },
