{
  "name": "git-workflow",
  "displayName": "Git Workflow",
  "description": "Discover git worktrees and compare each Working Tree against its base ref \u2014 GitLens-style, editable diffs.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabeklein/git-workflow.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "diff",
    "compare",
    "workflow",
    "claude"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Workflow",
      "properties": {
        "worktreeCompare.watchFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".worktrees"
          ],
          "description": "Workspace-relative folders where new worktrees (e.g. PR checkouts) are created. Discovery itself uses `git worktree list`, so worktrees are found no matter where they live on disk."
        },
        "worktreeCompare.defaultBaseRef": {
          "type": "string",
          "default": "main",
          "description": "Fallback base ref when a worktree's fork point cannot be inferred (reflog / merge-base / upstream)."
        },
        "worktreeCompare.includeRootCheckout": {
          "type": "string",
          "enum": [
            "dirty",
            "always",
            "never"
          ],
          "default": "dirty",
          "enumDescriptions": [
            "Only list the root checkout when it has uncommitted changes (hide when empty/clean)",
            "Always list the workspace root git checkout first",
            "Never list the root checkout (linked worktrees only)"
          ],
          "description": "Whether to include the main workspace checkout in the Worktrees list. Default: hide when clean (empty working tree)."
        },
        "worktreeCompare.squashLayout": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "default": "list",
          "description": "How to show files under Full Diff: flat list or nested directory tree."
        },
        "worktreeCompare.contentRefreshIntervalMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Hot-follow idle poll interval for the focused worktree (ms). 0 = off (default; events only). When >0, uses decaying active/idle poll. Prefer events; enable poll only if agents write outside the editor."
        },
        "worktreeCompare.contentRefreshActiveIntervalMs": {
          "type": "number",
          "default": 2500,
          "minimum": 1000,
          "description": "Hot-follow active poll interval (ms) after a change is detected. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.contentRefreshIdleAfterMs": {
          "type": "number",
          "default": 20000,
          "minimum": 3000,
          "description": "Quiet time before poll pace returns to idle. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.githubPullRequests": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use the GitHub CLI (gh) when available to detect PRs for worktree branches",
            "Disable GitHub PR status and context actions"
          ],
          "description": "Optional GitHub integration: PR badges on worktrees and branches, and Open/Copy PR actions. Requires authenticated `gh` on PATH."
        },
        "worktreeCompare.integrationBranch": {
          "type": "string",
          "default": "integration/{base}",
          "description": "Branch name of the integration overlay; {base} expands to the short base name (integration/main). Checking this branch out opts in: that checkout is rebuilt as the base plus a merge of each applied lane. Set to focus/working for interop with agent-focus's scripts/focus-working.sh (shared focus-applied file and lock)."
        },
        "worktreeCompare.integrationBaseRef": {
          "type": "string",
          "default": "",
          "description": "Base ref integration rebuilds start from (origin/\u2026 preferred when it resolves). Empty = use defaultBaseRef. Change via the Integration row's context menu."
        },
        "worktreeCompare.integrationAutoResolve": {
          "type": "string",
          "enum": [
            "off",
            "whitespace",
            "best-effort"
          ],
          "default": "best-effort",
          "enumDescriptions": [
            "Strict: any clash fails the rebuild. Non-overlapping edits to the same file still merge (git default).",
            "Also resolve whitespace-only clashes plus everything provably LOSSLESS: union when both lanes only inserted lines (changelog appends, import lists) and linewise 3-way for adjacent-line edits.",
            "Everything 'whitespace' does, and remaining text clashes resolve toward the incoming lane \u2014 the rebuild never fails on content, and any lane where a hunk was dropped is TAGGED 'auto-resolved' with the files listed. ('lane-wins' is accepted as a legacy alias.)"
          ],
          "description": "How far integration rebuilds may auto-resolve merge clashes between lanes. The integration tree is a derived, best-effort preview of unlanded work \u2014 lossless resolutions are silent, lossy ones are tagged on the lane row, and structural conflicts (edit vs delete) still fail honestly."
        },
        "worktreeCompare.catchUpStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "rebase",
            "merge"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Rebase unpushed lanes (history still private); merge the base into pushed lanes (no force-push, review anchors survive \u2014 squash landings erase the merge bubbles anyway).",
            "Always rebase; pushed lanes get a Force Push (with lease) offer afterward.",
            "Always merge the base in \u2014 never rewrites history."
          ],
          "description": "How Catch Up with Base brings a lane up to date with its base."
        },
        "worktreeCompare.autoRebaseLanes": {
          "type": "string",
          "enum": [
            "off",
            "local-only"
          ],
          "default": "off",
          "enumDescriptions": [
            "Never catch lanes up automatically \u2014 rows show 'N behind' / 'conflicts with <base>' with manual actions.",
            "Automatically catch up linked worktrees that are clean, behind the base, conflict-free, and NOT pushed (method follows catchUpStrategy). Pushed branches are never rewritten automatically \u2014 use Rebase onto Base\u2026, which offers a force-push with lease."
          ],
          "description": "Keep feature worktrees caught up with the base automatically when it is safe. A conflicting attempt aborts cleanly and marks the row 'conflicts with <base>'. Off by default: moving your branch is a side effect you opt into."
        },
        "worktreeCompare.integrationFetchIntervalMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "While integration mode is on, `git fetch origin <base>` this often (ms) so the integration tree tracks where PRs actually land; a moved tip triggers an auto-rebuild and landed lanes retire. 0 = never fetch automatically (manual Rebuild still fetches first)."
        },
        "worktreeCompare.integrationAbsorbStrays": {
          "type": "boolean",
          "default": true,
          "description": "When work is committed directly on the integration checkout, move it onto the base branch's worktree automatically (it then shows as unpushed base work). The integration tree is derived and gets reset on every rebuild, so those commits would otherwise deadlock the preview. Commits that ADD files while lanes are applied always ask first \u2014 an added file has no diff context, so unlike an edit it applies to the base cleanly even when its contents depend on lane code. Off = the rebuild keeps refusing until Absorb is run by hand. Uncommitted edits are never absorbed automatically."
        },
        "worktreeCompare.integrationCommitGuard": {
          "type": "boolean",
          "default": true,
          "description": "Install a pre-commit hook that refuses commits made while the integration branch is checked out. That branch is derived and rebuilt with reset --hard, so a commit there has no home. Use git commit --no-verify to override for a single commit. A pre-commit hook this extension did not write is never replaced."
        },
        "worktreeCompare.quickDeleteLandedWorktrees": {
          "type": "boolean",
          "default": true,
          "description": "Delete a landed worktree without the confirmation modal. Only applies when the branch's commits are already contained in its base AND the checkout is clean, unlocked, attached, and holds no ignored files \u2014 `git worktree remove` deletes ignored files (a local .env, build output) without complaint, and the dirty probe cannot see them. Off = every delete is confirmed."
        },
        "worktreeCompare.integrationAutoRebuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuild the integration worktree when the base or an applied lane tip moves (checked on the worktree-list poll). Off = rebuild only via the Rebuild Integration command or external hooks."
        },
        "worktreeCompare.remotePrLimit": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Max open pull requests fetched for the Branches panel's PR tags."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeCompare",
          "title": "Git Workflow",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktreeCompare": [
        {
          "id": "worktreeCompare.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "worktreeCompare.changes",
          "name": "Changes"
        },
        {
          "id": "worktreeCompare.files",
          "name": "Files"
        },
        {
          "id": "worktreeCompare.integration",
          "name": "Integration"
        },
        {
          "id": "worktreeCompare.branches",
          "name": "Branches"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeCompare.integration",
        "contents": "Integration mode is off.\nCombine feature branches onto a base \u2014 without touching the branches.\n[Enable Integration Mode](command:worktreeCompare.enableIntegration)"
      }
    ],
    "commands": [
