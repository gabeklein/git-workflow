    "menus": {
      "view/title": [
        {
          "command": "worktreeCompare.selectWorktree",
          "when": "view == worktreeCompare.lanes",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.focused",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.refreshPullRequests",
          "when": "view == worktreeCompare.lanes",
          "group": "navigation@3"
        },
        {
          "command": "worktreeCompare.refresh",
          "when": "view == worktreeCompare.lanes",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.focused && viewItem == conflictWarning",
          "group": "0_github@1"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.focused && viewItem == conflictWarning",
          "group": "0_compare@2"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.focused && viewItem == section:squash",
          "group": "inline"
        },
        {
          "command": "worktreeCompare.newFileInWorktree",
          "when": "view == worktreeCompare.focused && viewItem == explorerFolder",
          "group": "1_files@1"
        },
        {
          "command": "worktreeCompare.deleteWorktreeEntry",
          "when": "view == worktreeCompare.focused && viewItem =~ /^explorer(File|Folder)$/",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.lanes && viewItem =~ /WithPr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.lanes && viewItem =~ /WithPr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.openWorktree",
          "when": "view == worktreeCompare.lanes && viewItem =~ /^worktreeListItem/",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.openWorktreeTerminal",
          "when": "view == worktreeCompare.lanes && viewItem =~ /^worktreeListItem/",
          "group": "navigation@2"
        },
        {
          "command": "worktreeCompare.openWorktreeTerminal",
          "when": "view == worktreeCompare.lanes && viewItem =~ /HasWorktree/",
          "group": "navigation@2"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.focused && viewItem == group:ahead",
          "group": "0_compare@1"
        },
        {
          "command": "worktreeCompare.unlockWorktree",
          "when": "view == worktreeCompare.lanes && viewItem =~ /Locked/",
          "group": "1_worktree@1"
        },
        {
          "command": "worktreeCompare.catchUpWithBase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /BehindBase|ConflictsBase/",
          "group": "1_base@1"
        },
        {
          "command": "worktreeCompare.rebaseOntoBase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /BehindBase|ConflictsBase/",
          "group": "1_base@2"
        },
        {
          "command": "worktreeCompare.mergeFromBase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /BehindBase|ConflictsBase/",
          "group": "1_base@3"
        },
        {
          "command": "worktreeCompare.continueRebase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /Rebasing/",
          "group": "1_base@1"
        },
        {
          "command": "worktreeCompare.abortRebase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /Rebasing/",
          "group": "1_base@2"
        },
        {
          "command": "worktreeCompare.completeMergeFromBase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /MergingBase/",
          "group": "1_base@1"
        },
        {
          "command": "worktreeCompare.abortMergeFromBase",
          "when": "view == worktreeCompare.lanes && viewItem =~ /MergingBase/",
          "group": "1_base@2"
        },
        {
          "command": "worktreeCompare.addToPreview",
          "when": "view == worktreeCompare.lanes && viewItem =~ /LaneAddable/",
          "group": "2_preview@1"
        },
        {
          "command": "worktreeCompare.removeFromPreview",
          "when": "view == worktreeCompare.lanes && viewItem =~ /LaneCandidate/",
          "group": "2_preview@1"
        },
        {
          "command": "worktreeCompare.branchifyBaseDrift",
          "when": "view == worktreeCompare.lanes && viewItem == previewBaseDrift",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.catchUpPreviewBase",
          "when": "view == worktreeCompare.lanes && viewItem == previewBaseDrift",
          "group": "inline@2"
        },
        {
          "command": "worktreeCompare.branchifyBaseDrift",
          "when": "view == worktreeCompare.lanes && viewItem == previewBaseDrift",
          "group": "1_drift@1"
        },
        {
          "command": "worktreeCompare.catchUpPreviewBase",
          "when": "view == worktreeCompare.lanes && viewItem == previewBaseDrift",
          "group": "1_drift@2"
        },
        {
          "command": "worktreeCompare.resolveLaneConflict",
