          "id": "worktreeCompare.lanes",
          "name": "Lanes",
          "contextualTitle": "Lanes",
          "initialSize": 1
        },
        {
          "id": "worktreeCompare.focused",
          "name": "Focus",
          "initialSize": 3
        }
      ]
    },
