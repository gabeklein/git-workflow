    "menus": {
      "view/title": [
        {
          "command": "worktreeCompare.selectWorktree",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.changes",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.refreshPullRequests",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "worktreeCompare.refresh",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@4"
        },
        {
          "command": "worktreeCompare.refreshBranches",
          "when": "view == worktreeCompare.branches",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.newFileInWorktree",
          "when": "view == worktreeCompare.files",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.refreshFiles",
          "when": "view == worktreeCompare.files",
          "group": "navigation@2"
        },
        {
          "command": "worktreeCompare.rebuildIntegration",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.changeIntegrationBase",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "1_config@1"
        },
        {
          "command": "worktreeCompare.abortIntegrationMerge",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationMergePaused",
          "group": "1_config@2"
        },
        {
          "command": "worktreeCompare.absorbIntegrationEdits",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationDirty",
          "group": "1_config@3"
        },
        {
          "command": "worktreeCompare.disableIntegration",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "9_danger@1"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.changes && viewItem == conflictWarning",
          "group": "0_github@1"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.changes && viewItem == conflictWarning",
          "group": "0_compare@2"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.changes && viewItem == section:squash",
          "group": "inline"
        },
        {
          "command": "worktreeCompare.newFileInWorktree",
          "when": "view == worktreeCompare.files && viewItem == explorerFolder",
          "group": "1_files@1"
        },
        {
          "command": "worktreeCompare.deleteWorktreeEntry",
          "when": "view == worktreeCompare.files && viewItem =~ /^explorer(File|Folder)$/",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /WithPr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /WithPr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.openWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /^worktreeListItem/",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.changes && viewItem == group:ahead",
          "group": "0_compare@1"
        },
        {
          "command": "worktreeCompare.unlockWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Locked/",
          "group": "1_worktree@1"
        },
        {
          "command": "worktreeCompare.catchUpWithBase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /BehindBase|ConflictsBase/",
          "group": "1_base@1"
        },
        {
          "command": "worktreeCompare.rebaseOntoBase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /BehindBase|ConflictsBase/",
          "group": "1_base@2"
        },
        {
          "command": "worktreeCompare.mergeFromBase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /BehindBase|ConflictsBase/",
          "group": "1_base@3"
        },
        {
          "command": "worktreeCompare.continueRebase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Rebasing/",
          "group": "1_base@1"
        },
        {
          "command": "worktreeCompare.abortRebase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Rebasing/",
          "group": "1_base@2"
        },
        {
          "command": "worktreeCompare.completeMergeFromBase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /MergingBase/",
          "group": "1_base@1"
        },
        {
          "command": "worktreeCompare.abortMergeFromBase",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /MergingBase/",
          "group": "1_base@2"
        },
        {
          "command": "worktreeCompare.addToIntegration",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /LaneAddable/",
          "group": "2_integration@1"
        },
        {
          "command": "worktreeCompare.removeFromIntegration",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /LaneCandidate/",
          "group": "2_integration@1"
        },
        {
          "command": "worktreeCompare.branchifyBaseDrift",
          "when": "view == worktreeCompare.integration && viewItem == integrationBaseDrift",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.catchUpIntegrationBase",
          "when": "view == worktreeCompare.integration && viewItem == integrationBaseDrift",
          "group": "inline@2"
        },
        {
          "command": "worktreeCompare.branchifyBaseDrift",
          "when": "view == worktreeCompare.integration && viewItem == integrationBaseDrift",
          "group": "1_drift@1"
        },
        {
          "command": "worktreeCompare.catchUpIntegrationBase",
          "when": "view == worktreeCompare.integration && viewItem == integrationBaseDrift",
          "group": "1_drift@2"
        },
        {
          "command": "worktreeCompare.resolveLaneConflict",
          "when": "view == worktreeCompare.integration && viewItem =~ /Conflicted/",
          "group": "1_resolve@1"
        },
        {
          "command": "worktreeCompare.completeMergeFromBase",
          "when": "view == worktreeCompare.integration && viewItem =~ /Resolving/",
          "group": "1_resolve@1"
        },
        {
          "command": "worktreeCompare.abortMergeFromBase",
          "when": "view == worktreeCompare.integration && viewItem =~ /Resolving/",
          "group": "1_resolve@2"
        },
        {
          "command": "worktreeCompare.removeFromIntegration",
          "when": "view == worktreeCompare.integration && viewItem =~ /^integrationLane/",
          "group": "2_integration@1"
        },
        {
          "command": "worktreeCompare.includeWipInIntegration",
          "when": "view == worktreeCompare.integration && viewItem =~ /WipOff/",
          "group": "2_integration@2"
        },
        {
          "command": "worktreeCompare.excludeWipFromIntegration",
          "when": "view == worktreeCompare.integration && viewItem =~ /WipOn/",
          "group": "2_integration@2"
        },
        {
          "command": "worktreeCompare.deleteWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Removable/",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.branches && viewItem =~ /WithPr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.branches && viewItem =~ /WithPr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.createWorktreeFromBranch",
          "when": "view == worktreeCompare.branches && viewItem =~ /NoWorktree/",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.createWorktreeFromBranch",
          "when": "view == worktreeCompare.branches && viewItem =~ /NoWorktree/",
          "group": "2_worktree@1"
        },
        {
          "command": "worktreeCompare.copyCommitSha",
          "when": "view == worktreeCompare.changes && viewItem == commit",
          "group": "1_copy"
        },
        {
          "command": "worktreeCompare.stageFile",
          "when": "view == worktreeCompare.changes && viewItem == unstagedFile",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.stageFile",
          "when": "view == worktreeCompare.changes && viewItem == unstagedFile",
          "group": "1_scm"
        },
        {
          "command": "worktreeCompare.unstageFile",
          "when": "view == worktreeCompare.changes && viewItem == stagedFile",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.unstageFile",
          "when": "view == worktreeCompare.changes && viewItem == stagedFile",
          "group": "1_scm"
        },
        {
          "command": "worktreeCompare.commitStaged",
          "when": "view == worktreeCompare.changes && viewItem == section:staged",
          "group": "1_scm@1"
        },
        {
          "command": "worktreeCompare.commitUnstaged",
          "when": "view == worktreeCompare.changes && viewItem == section:unstaged",
          "group": "1_scm@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vsix": "npm run package && mkdir -p artifacts && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license -o artifacts/git-workflow-$npm_package_version.vsix",
    "install:local": "node scripts/install-local.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:edh": "node esbuild.js && node test/edh/run.mjs",
    "test:unit": "vitest run",
    "test": "npm run check-types:test && npm run test:unit && npm run test:edh",
    "check-types:test": "tsc --noEmit -p test/edh/tsconfig.json && tsc --noEmit -p test/unit/tsconfig.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
