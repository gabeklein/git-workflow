{
  "name": "git-workflow",
  "displayName": "Git Workflow",
  "description": "Discover git worktrees and compare each Working Tree against its base ref \u2014 GitLens-style, editable diffs.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabeklein/git-workflow.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "diff",
    "compare",
    "workflow",
    "claude"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Workflow",
      "properties": {
        "worktreeCompare.watchFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".worktrees"
          ],
          "description": "Workspace-relative folders where new worktrees (e.g. PR checkouts) are created. Discovery itself uses `git worktree list`, so worktrees are found no matter where they live on disk."
        },
        "worktreeCompare.defaultBaseRef": {
          "type": "string",
          "default": "main",
          "description": "Fallback base ref when a worktree's fork point cannot be inferred (reflog / merge-base / upstream)."
        },
        "worktreeCompare.includeRootCheckout": {
          "type": "string",
          "enum": [
            "dirty",
            "always",
            "never"
          ],
          "default": "dirty",
          "enumDescriptions": [
            "Only list the root checkout when it has uncommitted changes (hide when empty/clean)",
            "Always list the workspace root git checkout first",
            "Never list the root checkout (linked worktrees only)"
          ],
          "description": "Whether to include the main workspace checkout in the Worktrees list. Default: hide when clean (empty working tree)."
        },
        "worktreeCompare.squashLayout": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "default": "list",
          "description": "How to show files under Full Diff: flat list or nested directory tree."
        },
        "worktreeCompare.contentRefreshIntervalMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Hot-follow idle poll interval for the focused worktree (ms). 0 = off (default; events only). When >0, uses decaying active/idle poll. Prefer events; enable poll only if agents write outside the editor."
        },
        "worktreeCompare.contentRefreshActiveIntervalMs": {
          "type": "number",
          "default": 2500,
          "minimum": 1000,
          "description": "Hot-follow active poll interval (ms) after a change is detected. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.contentRefreshIdleAfterMs": {
          "type": "number",
          "default": 20000,
          "minimum": 3000,
          "description": "Quiet time before poll pace returns to idle. Only used when contentRefreshIntervalMs > 0."
        },
        "worktreeCompare.githubPullRequests": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use the GitHub CLI (gh) when available to detect PRs for worktree branches",
            "Disable GitHub PR status and context actions"
          ],
          "description": "Optional GitHub integration: PR badges on worktrees and branches, and Open/Copy PR actions. Requires authenticated `gh` on PATH."
        },
        "worktreeCompare.integrationBranch": {
          "type": "string",
          "default": "integration/{base}",
          "description": "Branch name of the integration overlay; {base} expands to the short base name (integration/main). Checking this branch out opts in: that checkout is rebuilt as the base plus a merge of each applied lane. Set to focus/working for interop with agent-focus's scripts/focus-working.sh (shared focus-applied file and lock)."
        },
        "worktreeCompare.integrationBaseRef": {
          "type": "string",
          "default": "",
          "description": "Base ref integration rebuilds start from (origin/\u2026 preferred when it resolves). Empty = use defaultBaseRef. Change via the Integration row's context menu."
        },
        "worktreeCompare.integrationAutoResolve": {
          "type": "string",
          "enum": [
            "off",
            "whitespace",
            "lane-wins"
          ],
          "default": "whitespace",
          "enumDescriptions": [
            "Strict: any clash fails the rebuild. Non-overlapping edits to the same file still merge (git default).",
            "Also resolve clashes where both sides differ only in whitespace \u2014 e.g. two lanes applied the same change with different formatting (-X ignore-space-change).",
            "Resolve every remaining text clash toward the incoming lane (-X theirs) \u2014 covers adjacent-line edits; the other side's clashing hunk is dropped."
          ],
          "description": "How far integration rebuilds may auto-resolve merge clashes between lanes. The integration tree is derived, so aggressive modes are recoverable \u2014 but resolved-away edits silently miss from the combined tree."
        },
        "worktreeCompare.integrationFetchIntervalMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "While integration mode is on, `git fetch origin <base>` this often (ms) so the integration tree tracks where PRs actually land; a moved tip triggers an auto-rebuild and landed lanes retire. 0 = never fetch automatically (manual Rebuild still fetches first)."
        },
        "worktreeCompare.integrationAutoRebuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuild the integration worktree when the base or an applied lane tip moves (checked on the worktree-list poll). Off = rebuild only via the Rebuild Integration command or external hooks."
        },
        "worktreeCompare.remotePrLimit": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Max open pull requests fetched for the Branches panel's PR tags."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeCompare",
          "title": "Git Workflow",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktreeCompare": [
        {
          "id": "worktreeCompare.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "worktreeCompare.changes",
          "name": "Changes"
        },
        {
          "id": "worktreeCompare.integration",
          "name": "Integration"
        },
        {
          "id": "worktreeCompare.branches",
          "name": "Branches"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeCompare.integration",
        "contents": "Integration mode is off.\nCombine feature branches onto a base \u2014 without touching the branches.\n[Enable Integration Mode](command:worktreeCompare.enableIntegration)"
      }
    ],
    "commands": [
      {
        "command": "worktreeCompare.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.selectWorktree",
        "title": "Select Worktree\u2026",
        "icon": "$(list-selection)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.focusWorktree",
        "title": "Focus Worktree",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openWorktree",
        "title": "Reveal Worktree in Explorer",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.deleteWorktree",
        "title": "Delete Worktree\u2026",
        "icon": "$(trash)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.unlockWorktree",
        "title": "Unlock Worktree",
        "icon": "$(unlock)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openFileDiff",
        "title": "Open File Diff",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.changeBaseRef",
        "title": "Change Base Ref",
        "icon": "$(git-compare)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.stageFile",
        "title": "Stage",
        "icon": "$(add)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.unstageFile",
        "title": "Unstage",
        "icon": "$(remove)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.commitStaged",
        "title": "Commit Staged\u2026",
        "icon": "$(check)",
        "category": "Git Workflow",
        "enablement": "worktreeCompare.hasStaged"
      },
      {
        "command": "worktreeCompare.commitUnstaged",
        "title": "Commit Unstaged\u2026",
        "icon": "$(check)",
        "category": "Git Workflow",
        "enablement": "worktreeCompare.hasUnstaged && !worktreeCompare.hasStaged"
      },
      {
        "command": "worktreeCompare.copyCommitSha",
        "title": "Copy Commit SHA",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openLogFile",
        "title": "Open Durable Log File",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.toggleSquashLayout",
        "title": "Toggle Full Diff List/Tree Layout",
        "icon": "$(list-tree)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openPullRequest",
        "title": "Open Pull Request on GitHub",
        "icon": "$(github)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.copyPullRequestUrl",
        "title": "Copy Pull Request URL",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.refreshPullRequests",
        "title": "Refresh Pull Request Status",
        "icon": "$(git-pull-request)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.refreshBranches",
        "title": "Refresh Branches",
        "icon": "$(refresh)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.openRemotePrFile",
        "title": "Open Read-only PR Diff",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.createWorktreeFromBranch",
        "title": "Create Worktree\u2026",
        "icon": "$(repo-clone)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.applyToIntegration",
        "title": "Apply to Integration",
        "icon": "$(combine)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.hideFromIntegration",
        "title": "Hide from Integration",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.rebuildIntegration",
        "title": "Rebuild Integration Worktree",
        "icon": "$(sync)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.abortIntegrationMerge",
        "title": "Abort Integration Merge",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.enableIntegration",
        "title": "Enable Integration Mode\u2026",
        "icon": "$(combine)",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.addToIntegration",
        "title": "Add to Integration",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.removeFromIntegration",
        "title": "Remove from Integration",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.includeWipInIntegration",
        "title": "Include Working-Tree Edits",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.excludeWipFromIntegration",
        "title": "Exclude Working-Tree Edits",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.disableIntegration",
        "title": "Disable Integration Mode\u2026",
        "category": "Git Workflow"
      },
      {
        "command": "worktreeCompare.changeIntegrationBase",
        "title": "Change Integration Base\u2026",
        "icon": "$(git-compare)",
        "category": "Git Workflow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeCompare.selectWorktree",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.changes",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.refreshPullRequests",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "worktreeCompare.refresh",
          "when": "view == worktreeCompare.worktrees",
          "group": "navigation@4"
        },
        {
          "command": "worktreeCompare.refreshBranches",
          "when": "view == worktreeCompare.branches",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.rebuildIntegration",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.changeIntegrationBase",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "1_config@1"
        },
        {
          "command": "worktreeCompare.abortIntegrationMerge",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "1_config@2"
        },
        {
          "command": "worktreeCompare.disableIntegration",
          "when": "view == worktreeCompare.integration && worktreeCompare.integrationOn",
          "group": "9_danger@1"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.changes && viewItem == conflictWarning",
          "group": "0_github@1"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.changes && viewItem == conflictWarning",
          "group": "0_compare@2"
        },
        {
          "command": "worktreeCompare.toggleSquashLayout",
          "when": "view == worktreeCompare.changes && viewItem == section:squash",
          "group": "inline"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /WithPr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /WithPr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.openWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /^worktreeListItem/",
          "group": "navigation@1"
        },
        {
          "command": "worktreeCompare.changeBaseRef",
          "when": "view == worktreeCompare.changes && viewItem == group:ahead",
          "group": "0_compare@1"
        },
        {
          "command": "worktreeCompare.unlockWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Locked/",
          "group": "1_worktree@1"
        },
        {
          "command": "worktreeCompare.addToIntegration",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /LaneAddable/",
          "group": "2_integration@1"
        },
        {
          "command": "worktreeCompare.removeFromIntegration",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /LaneCandidate/",
          "group": "2_integration@1"
        },
        {
          "command": "worktreeCompare.removeFromIntegration",
          "when": "view == worktreeCompare.integration && viewItem =~ /^integrationLane/",
          "group": "2_integration@1"
        },
        {
          "command": "worktreeCompare.includeWipInIntegration",
          "when": "view == worktreeCompare.integration && viewItem =~ /WipOff/",
          "group": "2_integration@2"
        },
        {
          "command": "worktreeCompare.excludeWipFromIntegration",
          "when": "view == worktreeCompare.integration && viewItem =~ /WipOn/",
          "group": "2_integration@2"
        },
        {
          "command": "worktreeCompare.disableIntegration",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /^integrationStatusOn/",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeCompare.deleteWorktree",
          "when": "view == worktreeCompare.worktrees && viewItem =~ /Removable/",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeCompare.openPullRequest",
          "when": "view == worktreeCompare.branches && viewItem =~ /WithPr/",
          "group": "1_github@1"
        },
        {
          "command": "worktreeCompare.copyPullRequestUrl",
          "when": "view == worktreeCompare.branches && viewItem =~ /WithPr/",
          "group": "1_github@2"
        },
        {
          "command": "worktreeCompare.createWorktreeFromBranch",
          "when": "view == worktreeCompare.branches && viewItem =~ /NoWorktree/",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.createWorktreeFromBranch",
          "when": "view == worktreeCompare.branches && viewItem =~ /NoWorktree/",
          "group": "2_worktree@1"
        },
        {
          "command": "worktreeCompare.copyCommitSha",
          "when": "view == worktreeCompare.changes && viewItem == commit",
          "group": "1_copy"
        },
        {
          "command": "worktreeCompare.stageFile",
          "when": "view == worktreeCompare.changes && viewItem == unstagedFile",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.stageFile",
          "when": "view == worktreeCompare.changes && viewItem == unstagedFile",
          "group": "1_scm"
        },
        {
          "command": "worktreeCompare.unstageFile",
          "when": "view == worktreeCompare.changes && viewItem == stagedFile",
          "group": "inline@1"
        },
        {
          "command": "worktreeCompare.unstageFile",
          "when": "view == worktreeCompare.changes && viewItem == stagedFile",
          "group": "1_scm"
        },
        {
          "command": "worktreeCompare.commitStaged",
          "when": "view == worktreeCompare.changes && viewItem == section:staged",
          "group": "1_scm@1"
        },
        {
          "command": "worktreeCompare.commitUnstaged",
          "when": "view == worktreeCompare.changes && viewItem == section:unstaged",
          "group": "1_scm@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "vsix": "npm run package && mkdir -p artifacts && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license -o artifacts/git-workflow-$npm_package_version.vsix",
    "install:local": "node scripts/install-local.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:edh": "node esbuild.js && node scripts/edh-test/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
